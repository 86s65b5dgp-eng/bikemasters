<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bike Masters — Cairo, Egypt</title>
<meta name="description" content="Bike Masters — Cairo's shop for serious road bikes, service and gear. Established 2018.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --asphalt:#14171a;
    --surface:#1c2024;
    --surface-raised:#24292e;
    --hairline:#333a40;
    --chalk:#edf0f2;
    --muted:#8b939b;
    --lime:#d6ff3f;
    --blue:#4b7fd6;
    --radius-s:2px;
    --radius-m:4px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}

  html{scroll-behavior:smooth;}

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important;}
  }

  body{
    background:var(--asphalt);
    color:var(--chalk);
    font-family:'Work Sans', sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }

  img{max-width:100%; display:block;}

  a{color:inherit; text-decoration:none;}

  .wrap{max-width:1180px; margin:0 auto; padding:0 28px;}

  .eyebrow{
    font-family:'Space Mono', monospace;
    font-size:12px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--lime);
  }

  h1,h2,h3{
    font-family:'Oswald', sans-serif;
    text-transform:uppercase;
    line-height:1.02;
    letter-spacing:.01em;
  }

  :focus-visible{
    outline:2px solid var(--lime);
    outline-offset:3px;
  }

  /* ---------- NAV ---------- */
  header{
    position:fixed; top:0; left:0; right:0; z-index:100;
    background:rgba(20,23,26,.86);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--hairline);
  }
  nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 28px;
    max-width:1180px; margin:0 auto;
  }
  .brand{display:flex; align-items:center; gap:12px;}
  .brand img{height:42px; width:42px; border-radius:50%;}
  .brand-text{font-family:'Oswald', sans-serif; font-weight:600; letter-spacing:.04em; font-size:17px; text-transform:uppercase;}
  .brand-text span{display:block; font-family:'Space Mono', monospace; font-size:10px; letter-spacing:.1em; color:var(--muted); text-transform:uppercase; font-weight:400;}

  .nav-links{display:flex; align-items:center; gap:32px;}
  .nav-links a{
    font-family:'Space Mono', monospace;
    font-size:12px; letter-spacing:.08em; text-transform:uppercase;
    color:var(--muted);
    transition:color .15s ease;
    position:relative;
  }
  .nav-links a:hover{color:var(--chalk);}

  .btn{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'Space Mono', monospace;
    font-size:12px; letter-spacing:.08em; text-transform:uppercase;
    padding:11px 20px;
    border-radius:var(--radius-s);
    border:1px solid var(--hairline);
    transition:all .15s ease;
    white-space:nowrap;
  }
  .btn-primary{ background:var(--lime); color:var(--asphalt); border-color:var(--lime); font-weight:700;}
  .btn-primary:hover{ background:#c3ec2c; }
  .btn-ghost{ color:var(--chalk); }
  .btn-ghost:hover{ border-color:var(--chalk); }

  .nav-cta{display:flex; gap:10px;}

  .menu-toggle{display:none; background:none; border:none; color:var(--chalk); font-size:22px; cursor:pointer;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    display:flex; align-items:flex-end;
    overflow:hidden;
    padding-top:90px;
  }
  .hero-bg{
    position:absolute; inset:0;
    background-image:linear-gradient(180deg, rgba(20,23,26,.35) 0%, rgba(20,23,26,.55) 45%, var(--asphalt) 96%), url('data:image/jpeg;base64,');
    background-size:cover;
    background-position:center 20%;
    filter:saturate(0.9);
  }
  .hero-content{
    position:relative; z-index:2;
    width:100%;
    padding-bottom:64px;
  }
  .meter-line{
    display:flex; flex-wrap:wrap; gap:6px 18px;
    font-family:'Space Mono', monospace;
    font-size:12px; letter-spacing:.06em;
    color:var(--muted);
    margin-bottom:22px;
    text-transform:uppercase;
  }
  .meter-line b{color:var(--lime); font-weight:700;}
  .meter-line .dot{color:var(--hairline);}

  .hero h1{
    font-size:clamp(40px, 8vw, 92px);
    max-width:900px;
    color:var(--chalk);
    text-shadow:0 2px 30px rgba(0,0,0,.4);
  }
  .hero h1 em{
    font-style:normal;
    color:var(--lime);
  }
  .hero p{
    max-width:520px;
    color:#cfd4d8;
    font-size:17px;
    margin-top:20px;
  }
  .hero-actions{
    display:flex; gap:14px; margin-top:34px; flex-wrap:wrap;
  }

  /* ---------- SECTION SHELL ---------- */
  section{ padding:110px 0; border-bottom:1px solid var(--hairline); }
  .section-head{
    display:flex; justify-content:space-between; align-items:flex-end;
    gap:24px; margin-bottom:56px; flex-wrap:wrap;
  }
  .section-head h2{ font-size:clamp(30px,4.5vw,48px); }
  .section-head p{ color:var(--muted); max-width:380px; font-size:15px; }

  /* ---------- BIKES / SPEC TICKETS ---------- */
  .bikes-grid{
    display:grid; grid-template-columns:1fr 1fr; gap:28px;
  }
  .ticket{
    background:var(--surface);
    border:1px solid var(--hairline);
    border-radius:var(--radius-m);
    overflow:hidden;
    position:relative;
    transition:border-color .2s ease, transform .2s ease;
  }
  .ticket:hover{ border-color:#4a525a; transform:translateY(-3px); }
  .ticket-photo{ position:relative; aspect-ratio:4/3; overflow:hidden; }
  .ticket-photo img{ width:100%; height:100%; object-fit:cover; }
  .ticket-badge{
    position:absolute; top:14px; left:14px;
    background:var(--asphalt);
    border:1px solid var(--hairline);
    color:var(--lime);
    font-family:'Space Mono', monospace;
    font-size:11px; letter-spacing:.08em; text-transform:uppercase;
    padding:6px 10px; border-radius:var(--radius-s);
  }
  .ticket-price{
    position:absolute; bottom:14px; right:14px;
    background:var(--lime); color:var(--asphalt);
    font-family:'Space Mono', monospace; font-weight:700;
    font-size:15px; padding:8px 14px; border-radius:var(--radius-s);
  }
  .ticket-body{ padding:26px 26px 28px; }
  .ticket-body h3{ font-size:26px; margin-bottom:2px; }
  .ticket-sub{ color:var(--muted); font-size:13px; font-family:'Space Mono', monospace; margin-bottom:18px; }
  .ticket-perf{
    border-top:1px dashed var(--hairline);
    margin:0 0 18px;
  }
  .spec-list{ list-style:none; }
  .spec-list li{
    display:flex; justify-content:space-between; gap:10px;
    font-family:'Space Mono', monospace; font-size:12.5px;
    padding:8px 0;
    border-bottom:1px solid rgba(255,255,255,.05);
    color:#c6cbcf;
  }
  .spec-list li span:first-child{ color:var(--muted); text-transform:uppercase; letter-spacing:.04em;}
  .spec-list li:last-child{border-bottom:none;}
  .ticket-cta{ margin-top:20px; display:flex; }

  /* ---------- WIDE GALLERY TICKET (featured build) ---------- */
  .ticket-wide{
    grid-column:1 / -1;
    display:grid;
    grid-template-columns:1.15fr 1fr;
  }
  .ticket-wide .ticket-photo{
    aspect-ratio:auto;
    display:flex;
    flex-direction:column;
    min-height:420px;
  }
  .ticket-wide .gallery-main{
    flex:1 1 auto;
    width:100%;
    min-height:0;
    object-fit:cover;
  }
  .gallery-thumbs{
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:2px;
    height:110px;
    flex:0 0 auto;
  }
  .gallery-thumbs img{ width:100%; height:100%; object-fit:cover; display:block; }
  .ticket-wide .ticket-body{ display:flex; flex-direction:column; justify-content:center; }
  @media (max-width:860px){
    .ticket-wide{ grid-template-columns:1fr; }
    .ticket-wide .ticket-photo{ min-height:320px; }
  }

  /* ---------- CATEGORIES ---------- */
  .category-grid{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:24px;
  }
  .category-card{
    display:block;
    background:var(--surface);
    border:1px solid var(--hairline);
    border-radius:var(--radius-m);
    padding:36px 30px;
    transition:border-color .2s ease, transform .2s ease, background .2s ease;
  }
  .category-card:hover{ border-color:var(--lime); transform:translateY(-3px); background:var(--surface-raised); }
  .category-icon{ width:52px; height:52px; color:var(--lime); margin-bottom:24px; }
  .category-card h3{ font-size:24px; margin-bottom:8px; }
  .category-card p{ color:var(--muted); font-size:14.5px; margin-bottom:20px; }
  .category-link{
    font-family:'Space Mono', monospace; font-size:12px; letter-spacing:.06em;
    text-transform:uppercase; color:var(--chalk);
  }

  /* ---------- SERVICES ---------- */
  .services-grid{
    display:grid; grid-template-columns:repeat(4, 1fr); gap:1px;
    background:var(--hairline);
    border:1px solid var(--hairline);
  }
  .service{
    background:var(--asphalt);
    padding:40px 32px;
    transition:background .2s ease;
  }
  .service:hover{ background:var(--surface); }
  .service .num{
    font-family:'Space Mono', monospace; color:var(--blue);
    font-size:12px; letter-spacing:.1em; margin-bottom:22px; display:block;
  }
  .service h3{ font-size:22px; margin-bottom:10px; }
  .service p{ color:var(--muted); font-size:14.5px; max-width:280px; }
  .service-cta{ margin-top:20px; display:inline-flex; }

  /* ---------- ABOUT ---------- */
  .about-grid{
    display:grid; grid-template-columns:1.1fr .9fr; gap:60px; align-items:center;
  }
  .about-copy p{ color:#c6cbcf; font-size:16px; margin-bottom:18px; max-width:480px; }
  .about-copy p:first-of-type{ font-size:19px; color:var(--chalk); }
  .stat-row{ display:flex; gap:36px; margin-top:36px; flex-wrap:wrap; }
  .stat{ font-family:'Space Mono', monospace; }
  .stat b{ display:block; font-size:32px; color:var(--lime); font-weight:700; }
  .stat span{ font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  .about-panel{
    background:var(--surface); border:1px solid var(--hairline);
    border-radius:var(--radius-m); padding:36px;
    font-family:'Space Mono', monospace;
  }
  .about-panel .eyebrow{ margin-bottom:18px; display:block; }
  .about-panel dl{ display:grid; grid-template-columns:auto 1fr; gap:10px 16px; font-size:13px; }
  .about-panel dt{ color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .about-panel dd{ color:var(--chalk); }

  /* ---------- CONTACT ---------- */
  .contact-grid{ display:grid; grid-template-columns:1fr 1fr; gap:60px; }
  .contact-list{ margin-top:28px; }
  .contact-item{
    display:flex; justify-content:space-between; align-items:center;
    padding:18px 0; border-bottom:1px solid var(--hairline);
  }
  .contact-item .label{ font-family:'Space Mono', monospace; font-size:11px; letter-spacing:.08em; text-transform:uppercase; color:var(--muted); }
  .contact-item .value{ font-size:17px; }
  .contact-item a.value:hover{ color:var(--lime); }
  .social-row{ display:flex; gap:12px; margin-top:28px; }
  .social-row a{
    border:1px solid var(--hairline); border-radius:var(--radius-s);
    padding:10px 16px; font-family:'Space Mono', monospace; font-size:12px;
    letter-spacing:.05em; text-transform:uppercase;
    transition:border-color .15s ease, color .15s ease;
  }
  .social-row a:hover{ border-color:var(--lime); color:var(--lime); }
  .map-frame{
    border:1px solid var(--hairline); border-radius:var(--radius-m); overflow:hidden;
    height:100%; min-height:340px;
  }
  .map-frame iframe{ width:100%; height:100%; min-height:340px; filter:grayscale(.4) invert(.92) contrast(.9); border:0; }

  /* ---------- FOOTER ---------- */
  footer{ padding:40px 0; }
  .footer-row{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; }
  .footer-brand{ display:flex; align-items:center; gap:10px; }
  .footer-brand img{ height:28px; width:28px; border-radius:50%; }
  .footer-brand span{ font-family:'Oswald', sans-serif; text-transform:uppercase; font-size:13px; letter-spacing:.05em; color:var(--muted); }
  footer .fine{ font-family:'Space Mono', monospace; font-size:11px; color:var(--muted); letter-spacing:.03em; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 860px){
    .nav-links{ display:none; }
    .menu-toggle{ display:block; }
    .bikes-grid{ grid-template-columns:1fr; }
    .services-grid{ grid-template-columns:1fr 1fr; }
    .category-grid{ grid-template-columns:1fr; }
    .about-grid{ grid-template-columns:1fr; }
    .contact-grid{ grid-template-columns:1fr; }
    section{ padding:72px 0; }
    .hero{ padding-top:150px; }
  }

  @media (max-width: 600px){
    nav{ padding:14px 20px; flex-wrap:wrap; row-gap:10px; }
    .brand-text{ font-size:15px; }
    .brand-text span{ font-size:9px; }
    .nav-cta{ width:100%; }
    .nav-cta .btn{ flex:1; justify-content:center; }
    .wrap{ padding:0 20px; }
    .hero{ padding-top:130px; }
    .meter-line{ font-size:11px; }
    .hero-actions{ flex-direction:column; }
    .hero-actions .btn{ justify-content:center; }
    .services-grid{ grid-template-columns:1fr; }
  }
</style>
</head>
