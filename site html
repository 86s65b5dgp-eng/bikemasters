              <li><span>Brakes</span><span>Disc, hydraulic</span></li>
              <li><span>Wheels</span><span>Zipp 303 carbon</span></li>
              <li><span>Saddle</span><span>Prologo Scratch NDR carbon</span></li>
            </ul>
            <div class="ticket-cta">
              <a class="btn btn-ghost" style="width:100%; justify-content:center;" href="https://wa.me/201554553024" target="_blank" rel="noopener">Ask about this bike</a>
            </div>
          </div>
        </article>

        <article class="ticket">
          <div class="ticket-photo">
            <img src="data:image/jpeg;base64," alt="TREK Emonda SL5, white, on the shop floor">
            <span class="ticket-badge">Full carbon frame</span>
          </div>
          <div class="ticket-body">
            <h3>TREK Emonda SL5</h3>
            <div class="ticket-sub">SIZE 54 · OVERDRIVE STEERER, DISC</div>
            <div class="ticket-perf"></div>
            <ul class="spec-list">
              <li><span>Shifters</span><span>Shimano 105, 12s</span></li>
              <li><span>Derailleurs</span><span>Shimano 105 F/R</span></li>
              <li><span>Brakes</span><span>Shimano 105 hydraulic</span></li>
              <li><span>Cassette</span><span>Shimano 105, 12-speed</span></li>
            </ul>
            <div class="ticket-cta">
              <a class="btn btn-ghost" style="width:100%; justify-content:center;" href="https://wa.me/201157343199" target="_blank" rel="noopener">Ask about this bike</a>
            </div>
          </div>
        </article>

        <article class="ticket ticket-wide">
          <div class="ticket-photo">
            <img class="gallery-main" src="data:image/jpeg;base64," alt="Specialized S-Works road bike, blue and white, side view">
            <div class="gallery-thumbs">
              <img src="data:image/jpeg;base64," alt="Roval cockpit and Dura-Ace shifter detail">
              <img src="data:image/jpeg;base64," alt="S-Works down tube and Roval Cotton tire detail">
