          <svg class="category-icon" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="14" cy="46" r="11" stroke="currentColor" stroke-width="2.5"/>
            <circle cx="50" cy="46" r="11" stroke="currentColor" stroke-width="2.5"/>
            <path d="M14 46L24 26H34L29 46M50 46L34 26M24 26L30 20H37" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M30 20L20 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
